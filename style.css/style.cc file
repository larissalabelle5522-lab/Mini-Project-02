header {
    background-color: #fd0000;
    color: red;
    padding: 20px;
}

header h1 {
    font-size: 36px;
    margin: 0;
}

body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

header, footer {
    background-color: red;
    color:white;
    text-align: center;
    padding: 20px;
}

nav ul {
    list-style: none;
    padding: 0;
}

nav ul li {
    display: inline-block;
    margin-right: 20px;
}

main {
    width: 70%;
    float: left;
    padding: 20px;
}

aside {
    width: 25%;
    float: right;
    padding: 20px;
    background: #f2f2f2;
}

footer {
    clear: both;
}